{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pockerrouter.dev/schemas/journey-v1.schema.json",
  "title": "PockerRouter Journey Snapshot v1",
  "type": "object",
  "required": ["id", "title", "origin", "destination", "steps", "sourceNote"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "origin": { "type": "string" },
    "destination": { "type": "string" },
    "sourceNote": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "instruction"],
        "properties": {
          "id": { "type": "string" },
          "instruction": { "type": "string" },
          "station": { "type": ["string", "null"] },
          "line": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
